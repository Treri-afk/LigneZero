# ── Supabase (service_role : SERVEUR UNIQUEMENT, jamais côté client) ──
SUPABASE_URL=https://hwhpxmrfwqgzhhrjfurd.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...            # Dashboard → Project Settings → API → service_role

# ── Application Twitch (dev.twitch.tv/console/apps) ──
TWITCH_CLIENT_ID=xxxxxxxxxxxxxxxx
TWITCH_CLIENT_SECRET=xxxxxxxxxxxxxxxx

# ── Compte bot (celui qui parle dans le chat) ──
# Token OAuth utilisateur du compte bot, scopes : chat:read chat:edit
# (générer via https://twitchtokengenerator.com ou ton propre flow OAuth)
TWITCH_BOT_USERNAME=mon_bot
TWITCH_BOT_ACCESS_TOKEN=xxxxxxxxxxxxxxxx
TWITCH_BOT_REFRESH_TOKEN=xxxxxxxxxxxxxxxx

# ── Token du BROADCASTER (optionnel — requis pour les ALERTES) ──
# Token OAuth du compte streamer, scopes :
#   channel:read:subscriptions bits:read moderator:read:followers
# Sans lui, les alertes sub/cheer/follow sont désactivées (le reste marche).
TWITCH_BROADCASTER_ACCESS_TOKEN=
TWITCH_BROADCASTER_REFRESH_TOKEN=

# ── Optionnel ──
# Chaîne écoutée (sinon lue depuis bot_config.twitch_channel dans le manager)
TWITCH_CHANNEL=ma_chaine
# Intervalle de scan des nouveaux clips pendant le live (secondes)
CLIP_POLL_SEC=60
# Lien Discord injecté dans le token {discord} (sinon bot_config.discord_invite)
DISCORD_INVITE=https://discord.gg/xxxx

# ── Bot Discord (optionnel) ──
# App + bot : https://discord.com/developers/applications (intent SERVER MEMBERS activé)
# Seul le TOKEN est requis ici (secret). Serveur/salon/rôle/message + toggles
# sont éditables dans le manager (/bot → « Bot Discord »). Les valeurs ci-dessous
# ne servent que de repli si la config manager est vide.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ANNOUNCE_CHANNEL_ID=
DISCORD_SUB_ROLE_ID=
DISCORD_LIVE_MESSAGE=🔴 On est EN LIVE !
